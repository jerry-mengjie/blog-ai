# backend-rag 运行环境配置(实际项目中应加入 .gitignore, 此处与 backend-blog 保持一致便于演示)

# ---------- 服务自身 ----------
SERVICE_PORT=8002
LOG_LEVEL=INFO
# 服务间调用令牌, 三个后端服务必须一致; 留空则不校验(仅本地开发)
INTERNAL_TOKEN=blog_ai-internal-token-change-me-in-production

# ---------- 上游服务 ----------
# backend-blog 地址(全量重建索引时回源拉取文章正文)
BLOG_BASE_URL=http://127.0.0.1:8000
HTTP_TIMEOUT=10.0
HTTP_MAX_CONNECTIONS=100

# ---------- 向量模型(OpenAI 兼容接口, 默认阿里云百炼) ----------
# 为空则本服务所有 RAG 接口返回 503, 上游自动降级
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBED_MODEL=text-embedding-v4
# 向量维度须与向量模型一致; 改动后集合会自动按新维度重建, 需重新执行全量索引
AI_EMBED_DIM=1024
# 单批向量化条数, 百炼兼容接口上限为 10
AI_EMBED_BATCH=10

# ---------- Milvus 向量库 ----------
MILVUS_URI=http://127.0.0.1:19530
# LlamaIndex 节点结构与旧 LangChain 集合不同, 使用独立集合名
MILVUS_COLLECTION=blog_rag_nodes
# 一致性级别: Bounded 允许秒级陈旧, 换取显著更高的检索吞吐
MILVUS_CONSISTENCY=Bounded
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=128
MILVUS_SEARCH_EF=64
MILVUS_BATCH_SIZE=128

# ---------- 分块与检索参数 ----------
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.3
RAG_MAX_CHUNKS=200
RAG_REINDEX_CONCURRENCY=4
# 画像召回时每篇行为文章取多少个开头分块作为代表向量
RAG_PROFILE_CHUNKS=3
RAG_PROFILE_CANDIDATES=256

# ---------- Redis(检索结果缓存) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
# 相同问题的检索结果缓存秒数, 命中即省下一次向量化 + 一次 Milvus 检索
RAG_RETRIEVE_CACHE_TTL=300
