# 应用运行环境配置(实际项目中应加入 .gitignore, 此处为方便演示保留)

# MySQL 9.7 连接 (caching_sha2_password + utf8mb4)
DATABASE_URL=mysql+aiomysql://root:qwqwqw78@127.0.0.1:3306/blog_ai?charset=utf8mb4
# 连接池 (与 config/mysql97.cnf 中 wait_timeout=28800 对齐)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=28000
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# JWT 签名密钥(生产环境务必替换为随机长字符串)
SECRET_KEY=blog_ai-super-secret-key-change-me-in-production
# JWT 加密算法
ALGORITHM=HS256
# 访问令牌过期时间(分钟), 默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 跨域允许的前端来源(逗号分隔): 移动端 + 管理后台
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- AI 问答 (RAG) ----------
# OpenAI 兼容接口的 API Key(阿里云百炼: https://bailian.console.aliyun.com/ 获取), 为空则 AI 问答功能自动关闭
AI_API_KEY=
# OpenAI 兼容接口基础地址(默认阿里云百炼, 也可换成其他兼容服务)
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型
AI_CHAT_MODEL=qwen-plus
# 向量模型
AI_EMBED_MODEL=text-embedding-v4
# 向量维度(须与向量模型一致, text-embedding-v4 支持 1024)
AI_EMBED_DIM=1024
# 单 IP 每分钟提问上限
AI_RATE_LIMIT=10

# ---------- Milvus 向量库 ----------
# Milvus gRPC 地址(deploy/milvus/docker-compose.yml standalone 部署, 默认 19530)
MILVUS_URI=http://127.0.0.1:19530
# 集合名称
MILVUS_COLLECTION=blog_article_chunks

# ---------- Redis(文章列表 L1 内存 + L2 Redis 多级缓存) ----------
# docker: redis:latest --requirepass 123456 -p 6379:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
# 第 1 页缓存过期秒数(浏览量允许短时陈旧)
ARTICLE_LIST_CACHE_TTL=60
# 进程内 L1 最大 key 数
ARTICLE_LIST_L1_MAXSIZE=256
# 推荐接口缓存过期秒数(个性化短 TTL)
REC_ARTICLE_CACHE_TTL=30
# 推荐接口 L1 最大 key 数(用户维度分 key)
REC_ARTICLE_L1_MAXSIZE=512

# ---------- RocketMQ(浏览统计异步写) ----------
# Proxy gRPC 地址; 留空则关闭 MQ, 接口同步写库。启用示例: 127.0.0.1:8022
# 注意: 官方 Python 客户端连的是 Proxy, 不是 NameServer 9876
# ROCKETMQ_ENDPOINTS=127.0.0.1:8022
# 浏览统计 Topic(Tag: report=用户上报, pv=文章全局浏览量)
ROCKETMQ_TOPIC_BROWSE=blog_browse
# 浏览统计消费组
ROCKETMQ_GROUP_BROWSE=blog_browse_consumer
