# 应用运行环境配置(实际项目中应加入 .gitignore, 此处为方便演示保留)

# MySQL 9.7 连接 (caching_sha2_password + utf8mb4)
DATABASE_URL=mysql+aiomysql://root:qwqwqw78@127.0.0.1:3306/blog_ai?charset=utf8mb4
# 连接池 (与 config/mysql97.cnf 中 wait_timeout=28800 对齐)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=28000
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# JWT 签名密钥(生产环境务必替换为随机长字符串)
SECRET_KEY=blog_ai-super-secret-key-change-me-in-production
# JWT 加密算法
ALGORITHM=HS256
# 访问令牌过期时间(分钟), 默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 跨域允许的前端来源(逗号分隔): 移动端 + 管理后台
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
