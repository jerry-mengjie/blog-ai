# 应用运行环境配置(实际项目中应加入 .gitignore, 此处为方便演示保留)

# MySQL 9.7 连接 (caching_sha2_password + utf8mb4)
DATABASE_URL=mysql+aiomysql://root:qwqwqw78@127.0.0.1:3306/blog_ai?charset=utf8mb4
# 连接池 (与 config/mysql97.cnf 中 wait_timeout=28800 对齐)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=28000
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# JWT 签名密钥(生产环境务必替换为随机长字符串)
SECRET_KEY=blog_ai-super-secret-key-change-me-in-production
# JWT 加密算法
ALGORITHM=HS256
# 访问令牌过期时间(分钟), 默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 跨域允许的前端来源(逗号分隔): 移动端 + 管理后台
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- 服务间调用 ----------
# 服务间令牌(三个后端服务必须完全一致; 留空则 /internal/* 不校验, 仅限本地)
INTERNAL_TOKEN=blog_ai-internal-token-change-me-in-production
# backend-rag 地址(文章变更后推送索引), 留空则关闭索引同步
RAG_BASE_URL=http://127.0.0.1:8002
# backend-agent 地址(文章变更后通知失效推荐缓存), 留空则关闭通知
AGENT_BASE_URL=http://127.0.0.1:8001
# 服务间 HTTP 超时秒数
SERVICE_HTTP_TIMEOUT=10.0
# 服务间 HTTP 连接池上限
SERVICE_HTTP_MAX_CONNECTIONS=50

# ---------- Redis(文章列表 L1 内存 + L2 Redis 多级缓存) ----------
# docker: redis:8-alpine --name redis -p 6379:6379 -v redis_data:/data --requirepass qwqwqw78
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=qwqwqw78
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
# 第 1 页缓存过期秒数(浏览量允许短时陈旧)
ARTICLE_LIST_CACHE_TTL=60
# 进程内 L1 最大 key 数
ARTICLE_LIST_L1_MAXSIZE=256

# ---------- RocketMQ(浏览统计异步写) ----------
# Proxy gRPC 地址; 留空则关闭 MQ, 接口同步写库。启用示例: 127.0.0.1:8022
# 注意: 官方 Python 客户端连的是 Proxy, 不是 NameServer 9876
ROCKETMQ_ENDPOINTS=127.0.0.1:8022
# 浏览统计 Topic(Tag: report=用户上报, pv=文章全局浏览量)
ROCKETMQ_TOPIC_BROWSE=blog_browse
# 浏览统计消费组
ROCKETMQ_GROUP_BROWSE=blog_browse_consumer
