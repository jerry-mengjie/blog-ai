# backend-agent 环境变量模板: 复制为 .env 后按需修改

# ---------- 服务自身 ----------
SERVICE_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 服务间调用令牌, 三个后端服务必须一致
INTERNAL_TOKEN=

# ---------- JWT(必须与 backend-blog 完全一致) ----------
SECRET_KEY=change-me-to-the-same-value-as-backend-blog
ALGORITHM=HS256

# ---------- 下游服务 ----------
BLOG_BASE_URL=http://127.0.0.1:8000
RAG_BASE_URL=http://127.0.0.1:8002
HTTP_TIMEOUT=10.0
HTTP_REINDEX_TIMEOUT=600.0
HTTP_MAX_CONNECTIONS=100

# ---------- 对话模型(OpenAI 兼容接口) ----------
# 阿里云百炼申请: https://bailian.console.aliyun.com/
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_TEMPERATURE=0.3
AI_TIMEOUT=60.0
AI_MAX_RETRIES=2
AI_RATE_LIMIT=10

# ---------- 检索参数(下发给 backend-rag) ----------
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.3

# ---------- 推荐参数 ----------
REC_BEHAVIOR_LIMIT=20
REC_FAVORITE_WEIGHT=2.0
REC_RECALL_BUFFER=2

# ---------- Redis(推荐缓存 L2 + 分布式限流) ----------
# 留空则关闭 Redis: 推荐仅用进程内 L1, 限流退化为单机内存
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=qwqwqw78
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
REC_ARTICLE_CACHE_TTL=30
REC_ARTICLE_L1_MAXSIZE=512
