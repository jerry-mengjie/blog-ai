# backend-agent 运行环境配置(实际项目中应加入 .gitignore, 此处与 backend-blog 保持一致便于演示)

# ---------- 服务自身 ----------
SERVICE_PORT=8001
LOG_LEVEL=INFO
# 跨域允许的前端来源(逗号分隔): 移动端 + 管理后台
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 服务间调用令牌, 三个后端服务必须一致; 留空则不校验(仅本地开发)
INTERNAL_TOKEN=blog_ai-internal-token-change-me-in-production

# ---------- JWT(必须与 backend-blog 完全一致, 否则无法识别登录用户) ----------
SECRET_KEY=blog_ai-super-secret-key-change-me-in-production
ALGORITHM=HS256

# ---------- 下游服务 ----------
BLOG_BASE_URL=http://127.0.0.1:8000
RAG_BASE_URL=http://127.0.0.1:8002
HTTP_TIMEOUT=10.0
# 全量重建索引是长任务, 单独放宽超时
HTTP_REINDEX_TIMEOUT=600.0
HTTP_MAX_CONNECTIONS=100

# ---------- 对话模型(OpenAI 兼容接口, 默认阿里云百炼) ----------
# 为空则 AI 问答自动关闭, 前端隐藏入口
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_TEMPERATURE=0.3
AI_TIMEOUT=60.0
AI_MAX_RETRIES=2
# 单 IP 每分钟提问上限(基于 Redis 计数, 多副本共享)
AI_RATE_LIMIT=10

# ---------- 检索参数(下发给 backend-rag) ----------
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.3

# ---------- 推荐参数 ----------
REC_BEHAVIOR_LIMIT=20
REC_FAVORITE_WEIGHT=2.0
REC_RECALL_BUFFER=2

# ---------- Redis(推荐缓存 L2 + 分布式限流) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
# 推荐结果缓存过期秒数(个性化短 TTL)
REC_ARTICLE_CACHE_TTL=30
# 推荐结果 L1 最大 key 数(用户维度分 key)
REC_ARTICLE_L1_MAXSIZE=512
